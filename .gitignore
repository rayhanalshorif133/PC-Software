test_export_run.mp4
*_export*
output_*
*.tmp
*.temp

# ==========================================
# IDE & Code Editor Files
# ==========================================
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# ==========================================
# Operating System Files
# ==========================================
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ==========================================
