{
  "name": "cinecut-studio",
  "productName": "CineCut Studio",
  "version": "1.0.0",
  "description": "Modern Video Editor, Splitter and Merger Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win portable"
  },
  "keywords": [
    "video-editor",
    "video-cutter",
    "video-splitter",
    "video-merger",
    "electron"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "systeminformation": "^5.33.19"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.cinecut.studio",
    "productName": "CineCut Studio",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**",
      "**/node_modules/ffprobe-static/**"
    ],
    "files": [
      "**/*",
      "!test_sample.mp4",
      "!test_merged.mp4",
      "!dist/**"
    ],
    "win": {
      "target": "portable",
      "requestedExecutionLevel": "asInvoker"
    },
    "portable": {
      "artifactName": "CineCut-Studio.exe"
    }
  }
}
